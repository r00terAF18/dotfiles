## Night City (Cyberpunk 2077) config for cava.
## Generated from scripts/night-city/palette.sh by scripts/night-city/generate.sh; edit the template, not dist/.
## Linked to ~/.config/cava/config by scripts/night-city/install.sh. Everything not set here uses cava's defaults.

[general]
framerate = 60
bar_width = 2
bar_spacing = 1

[input]
; cava picks PipeWire/Pulse automatically

[output]
method = noncurses

[color]
; transparent background, so kitty's Night City background shows through
background = default
foreground = '#FCEE0A'

; vertical gradient, bottom to top: cyan -> magenta -> red -> yellow
gradient = 1
gradient_color_1 = '#00F0FF'
gradient_color_2 = '#FF2BD6'
gradient_color_3 = '#FF003C'
gradient_color_4 = '#FCEE0A'

[smoothing]
noise_reduction = 77
