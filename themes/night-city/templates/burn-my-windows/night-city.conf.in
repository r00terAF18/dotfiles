# Night City (Cyberpunk 2077) effect profile for Burn My Windows: a yellow TV glitch when
# windows open and close. Generated from palette.sh by generate.sh.
# install.sh copies (not links) this into ~/.config/burn-my-windows/profiles/, because the
# extension's preferences rewrite profile files in place. High priority, so it wins over
# any other profile.
[burn-my-windows-profile]
profile-high-priority=true
profile-animation-type=0
fire-enable-effect=false
tv-glitch-enable-effect=true
tv-glitch-animation-time=500
tv-glitch-scale=1.0
tv-glitch-strength=2.0
tv-glitch-speed=2.0
tv-glitch-color='rgb({{yellow_rgb}})'
