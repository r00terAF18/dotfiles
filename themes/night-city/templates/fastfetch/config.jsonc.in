// Night City (Cyberpunk 2077) config for fastfetch.
// Generated from themes/night-city/palette.sh by generate.sh; edit the template, not dist/.
// Linked to ~/.config/fastfetch/config.jsonc by install.sh. Needs a Nerd Font.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "color": {
      "1": "{{yellow}}",
      "2": "{{cyan}}",
      "3": "{{red}}"
    },
    "padding": {
      "top": 1,
      "right": 3
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "{{yellow}}",
      "title": "{{cyan}}",
      "separator": "{{red}}",
      "output": "{{fg}}"
    },
    "key": {
      "width": 13
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "// NIGHT CITY · NETRUNNER LINK ESTABLISHED",
      "outputColor": "{{red}}"
    },
    "title",
    {
      "type": "separator",
      "string": "─",
      "outputColor": "{{yellow}}"
    },
    {
      "type": "os",
      "key": "󰣇  OS"
    },
    {
      "type": "kernel",
      "key": "  KERNEL"
    },
    {
      "type": "uptime",
      "key": "󰥔  UPTIME"
    },
    {
      "type": "packages",
      "key": "󰏖  PACKAGES"
    },
    {
      "type": "shell",
      "key": "  SHELL"
    },
    {
      "type": "de",
      "key": "󰍹  DE"
    },
    {
      "type": "terminal",
      "key": "  TERMINAL",
      "keyColor": "{{cyan}}"
    },
    {
      "type": "font",
      "key": "  FONT",
      "keyColor": "{{cyan}}"
    },
    {
      "type": "theme",
      "key": "󰏘  THEME",
      "keyColor": "{{cyan}}"
    },
    {
      "type": "icons",
      "key": "󰎁  ICONS",
      "keyColor": "{{cyan}}"
    },
    {
      "type": "cpu",
      "key": "  CPU",
      "keyColor": "{{magenta}}"
    },
    {
      "type": "gpu",
      "key": "󰢖  GPU",
      "keyColor": "{{magenta}}"
    },
    {
      "type": "memory",
      "key": "  MEMORY",
      "keyColor": "{{magenta}}"
    },
    {
      "type": "disk",
      "key": "󰋊  DISK",
      "keyColor": "{{magenta}}",
      "folders": "/"
    },
    "break",
    {
      "type": "colors",
      "symbol": "block"
    }
  ]
}
