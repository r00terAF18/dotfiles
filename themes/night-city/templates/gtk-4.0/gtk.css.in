/* Night City (Cyberpunk 2077) for GTK4 / libadwaita.
 * Generated from themes/night-city/palette.sh by generate.sh; edit the template, not dist/.
 * Linked to ~/.config/gtk-4.0/gtk.css by install.sh. Restart apps to see changes.
 *
 * libadwaita ignores GTK themes, but it does read this user stylesheet, which has the
 * highest priority. libadwaita >= 1.6 uses the CSS variables in :root; the @define-color
 * names keep older libadwaita and plain GTK4 apps in line. These colours are dark, so the
 * theme expects color-scheme = prefer-dark (install.sh sets it).
 */

@define-color accent_bg_color {{yellow}};
@define-color accent_fg_color {{bg0}};
@define-color accent_color {{yellow}};
@define-color destructive_bg_color {{red}};
@define-color destructive_fg_color #ffffff;
@define-color destructive_color {{bright_red}};
@define-color success_bg_color {{green}};
@define-color success_fg_color {{bg0}};
@define-color success_color {{green}};
@define-color warning_bg_color {{orange}};
@define-color warning_fg_color {{bg0}};
@define-color warning_color {{orange}};
@define-color error_bg_color {{red}};
@define-color error_fg_color #ffffff;
@define-color error_color {{bright_red}};
@define-color window_bg_color {{bg0}};
@define-color window_fg_color {{fg}};
@define-color view_bg_color {{bg1}};
@define-color view_fg_color {{fg}};
@define-color headerbar_bg_color {{bg0}};
@define-color headerbar_fg_color {{fg}};
@define-color headerbar_border_color {{yellow}};
@define-color headerbar_backdrop_color {{bg0}};
@define-color headerbar_shade_color rgba(0, 0, 0, 0.6);
@define-color sidebar_bg_color {{bg1}};
@define-color sidebar_fg_color {{fg}};
@define-color sidebar_backdrop_color {{bg1}};
@define-color sidebar_shade_color rgba(0, 0, 0, 0.36);
@define-color sidebar_border_color {{border}};
@define-color secondary_sidebar_bg_color {{bg1}};
@define-color secondary_sidebar_fg_color {{fg}};
@define-color secondary_sidebar_backdrop_color {{bg1}};
@define-color secondary_sidebar_shade_color rgba(0, 0, 0, 0.36);
@define-color secondary_sidebar_border_color {{border}};
@define-color card_bg_color {{bg2}};
@define-color card_fg_color {{fg}};
@define-color card_shade_color rgba(0, 0, 0, 0.36);
@define-color dialog_bg_color {{bg1}};
@define-color dialog_fg_color {{fg}};
@define-color popover_bg_color {{bg1}};
@define-color popover_fg_color {{fg}};
@define-color popover_shade_color rgba(0, 0, 0, 0.5);
@define-color thumbnail_bg_color {{bg2}};
@define-color thumbnail_fg_color {{fg}};
@define-color shade_color rgba(0, 0, 0, 0.5);
@define-color scrollbar_outline_color rgba(0, 0, 0, 0.5);

:root {
  /* GNOME's accent presets, remapped to the palette (Settings > Appearance still works) */
  --accent-blue: {{blue}};
  --accent-teal: {{cyan}};
  --accent-green: {{green}};
  --accent-yellow: {{yellow}};
  --accent-orange: {{orange}};
  --accent-red: {{red}};
  --accent-pink: {{magenta}};
  --accent-purple: {{purple}};
  --accent-slate: {{fg_dim}};

  /* The accent itself: neon yellow with black text on it */
  --accent-bg-color: {{yellow}};
  --accent-fg-color: {{bg0}};
  --accent-color: {{yellow}};

  --destructive-bg-color: {{red}};
  --destructive-fg-color: #ffffff;
  --destructive-color: {{bright_red}};
  --success-bg-color: {{green}};
  --success-fg-color: {{bg0}};
  --success-color: {{green}};
  --warning-bg-color: {{orange}};
  --warning-fg-color: {{bg0}};
  --warning-color: {{orange}};
  --error-bg-color: {{red}};
  --error-fg-color: #ffffff;
  --error-color: {{bright_red}};

  --window-bg-color: {{bg0}};
  --window-fg-color: {{fg}};
  --view-bg-color: {{bg1}};
  --view-fg-color: {{fg}};
  --headerbar-bg-color: {{bg0}};
  --headerbar-fg-color: {{fg}};
  --headerbar-border-color: {{yellow}};
  --headerbar-backdrop-color: {{bg0}};
  --headerbar-shade-color: rgba(0, 0, 0, 0.6);
  --sidebar-bg-color: {{bg1}};
  --sidebar-fg-color: {{fg}};
  --sidebar-backdrop-color: {{bg1}};
  --sidebar-shade-color: rgba(0, 0, 0, 0.36);
  --sidebar-border-color: {{border}};
  --secondary-sidebar-bg-color: {{bg1}};
  --secondary-sidebar-fg-color: {{fg}};
  --secondary-sidebar-backdrop-color: {{bg1}};
  --secondary-sidebar-shade-color: rgba(0, 0, 0, 0.36);
  --secondary-sidebar-border-color: {{border}};
  --card-bg-color: {{bg2}};
  --card-fg-color: {{fg}};
  --card-shade-color: rgba(0, 0, 0, 0.36);
  --dialog-bg-color: {{bg1}};
  --dialog-fg-color: {{fg}};
  --popover-bg-color: {{bg1}};
  --popover-fg-color: {{fg}};
  --popover-shade-color: rgba(0, 0, 0, 0.5);
  --thumbnail-bg-color: {{bg2}};
  --thumbnail-fg-color: {{fg}};
  --shade-color: rgba(0, 0, 0, 0.5);
  --scrollbar-outline-color: rgba(0, 0, 0, 0.5);
}

/* ---- Neon details (kept small so app layouts don't break) ---- */

/* Window titles and headings in Rajdhani, the font of the game's HUD (falls back if it isn't
 * installed). Body text keeps the normal interface font. */
headerbar .title,
windowtitle .title,
.title-1,
.title-2,
.title-3,
.title-4,
.heading,
preferencesgroup > box > box > .heading,
statuspage > scrolledwindow > viewport > box > clamp > box > .title {
  font-family: "Rajdhani", sans-serif;
  font-weight: 700;
  letter-spacing: 1px;
}

/* Thin neon line under header bars */
headerbar {
  box-shadow: inset 0 -1px alpha({{yellow}}, 0.35);
}

/* Selected sidebar row gets a yellow edge, like the game's menus */
.navigation-sidebar > row:selected,
.sidebar-pane row:selected {
  box-shadow: inset 3px 0 {{yellow}};
}

/* Cyan focus rings */
*:focus-visible {
  outline-color: alpha({{cyan}}, 0.7);
}

/* Text selection */
selection,
text selection {
  background-color: alpha({{cyan}}, 0.35);
  color: {{fg}};
}
